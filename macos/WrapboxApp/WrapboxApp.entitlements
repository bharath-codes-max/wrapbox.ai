<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets this app ask OSSystemExtensionManager to install the extension. -->
	<key>com.apple.developer.system-extension.install</key><true/>
	<!-- Required to create/enable/disable the NETransparentProxyManager
	     configuration (enable / disable / remove / status). Development value;
	     see the extension's entitlements for the distribution note. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>app-proxy-provider</string>
	</array>
	<!-- NEMachServiceName (377DAPKD9V.io.wrapbox.WrapboxProxy.extension) must be
	     prefixed by an App Group in this entitlement, or system-extension
	     activation fails validation (OSSystemExtensionErrorDomain code 9).
	     Team-ID-prefixed groups are the macOS-native form and need no portal
	     registration; $(TeamIdentifierPrefix) expands to "377DAPKD9V.". -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)io.wrapbox.WrapboxProxy</string>
	</array>
	<key>com.apple.security.app-sandbox</key><false/>
</dict>
</plist>
