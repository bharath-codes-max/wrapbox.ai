<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NETransparentProxyProvider subclasses NEAppProxyProvider, so the value is
	     the app-proxy one.

	     DEVELOPMENT vs DISTRIBUTION — this bit is easy to get wrong:
	       development (Mac Team Provisioning Profile) grants the PLAIN values:
	         app-proxy-provider, content-filter-provider, packet-tunnel-provider, ...
	       Developer ID distribution requires the -systemextension suffixed values:
	         app-proxy-provider-systemextension
	     and those are NOT in a development profile. Verified by decoding the
	     profile Apple generated for 377DAPKD9V.io.wrapbox.WrapboxProxy.extension.

	     So: keep `app-proxy-provider` to build and test locally. Switch to
	     `app-proxy-provider-systemextension` only once the Network Extension
	     DISTRIBUTION entitlement has been granted by Apple — a separate request
	     from the Endpoint Security one. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>app-proxy-provider</string>
	</array>
	<!-- NEMachServiceName (377DAPKD9V.io.wrapbox.WrapboxProxy.extension) must be
	     prefixed by an App Group in this entitlement, or system-extension
	     activation fails validation (OSSystemExtensionErrorDomain code 9).
	     Team-ID-prefixed groups are the macOS-native form and need no portal
	     registration; $(TeamIdentifierPrefix) expands to "377DAPKD9V.". -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)io.wrapbox.WrapboxProxy</string>
	</array>
	<key>com.apple.security.app-sandbox</key><false/>
</dict>
</plist>
